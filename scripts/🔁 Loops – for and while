

    #range
    num=range(1,11)  #1 to 10
    print(num)

    #loops
#while loop
i=1
while i<=10:
    print(i)
    i+=1

    i=1
    while i<=10:
        print(i *"*")
        i+=1


       
        i=5
        while i>0:
            print(i * "@")
            i-=1

#for loop
for i in range(5):
    print(i)

for i in range(1,6):       #1to5
    print(i)    

# multiples of 2
for i in range(1,11):
    if i%2==0:
        print(i)
#other method
for i in range(2,11,2):  #2 to 10
    print(i)

#break
for i in range(1,51):
    if i==21:
        break
    if i%3==0:
        print(i)

    print("This is outside the for loop.")


#continue  to skip the current iteration and move to the next iteration
for i in range(1,51):
    if i==21:
        continue
    if i%3==0:
        print(i)

    print("This is outside the for loop.")

